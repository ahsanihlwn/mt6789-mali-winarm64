diff --git a/src/panfrost/vulkan/panvk_instance.c b/src/panfrost/vulkan/panvk_instance.c
index 062d0ebd..8afcec0d 100644
--- a/src/panfrost/vulkan/panvk_instance.c
+++ b/src/panfrost/vulkan/panvk_instance.c
@@ -9,8 +9,11 @@
  * SPDX-License-Identifier: MIT
  */
 
+#include <string.h>
+
 #include "util/build_id.h"
 #include "util/mesa-sha1.h"
+#include "git_sha1.h"
 
 #include "vk_alloc.h"
 #include "vk_log.h"
@@ -155,6 +158,7 @@ panvk_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
 
    assert(pCreateInfo->sType == VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO);
 
+#ifdef HAVE_DL_ITERATE_PHDR
    const struct build_id_note *note =
       build_id_find_nhdr_for_addr(panvk_CreateInstance);
    if (!note) {
@@ -167,6 +171,7 @@ panvk_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
       return panvk_errorf(NULL, VK_ERROR_INITIALIZATION_FAILED,
                           "build-id too short.  It needs to be a SHA");
    }
+#endif
 
    pAllocator = pAllocator ?: vk_default_allocator();
    instance = vk_zalloc(pAllocator, sizeof(*instance), 8,
@@ -206,7 +211,20 @@ panvk_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
    VG(VALGRIND_CREATE_MEMPOOL(instance, 0, false));
 
    STATIC_ASSERT(sizeof(instance->driver_build_sha) == SHA1_DIGEST_LENGTH);
+#ifdef HAVE_DL_ITERATE_PHDR
    memcpy(instance->driver_build_sha, build_id_data(note), SHA1_DIGEST_LENGTH);
+#else
+   /* Windows has no ELF build-id note (util/build_id.h only declares these
+    * helpers under HAVE_DL_ITERATE_PHDR). Derive a stable, reproducible driver
+    * UUID from the compile-time git SHA1 instead of failing instance creation;
+    * panvk_physical_device.c copies it into VkPhysicalDeviceDriverProperties.
+    */
+   memset(instance->driver_build_sha, 0, sizeof(instance->driver_build_sha));
+   size_t sha_len = strlen(MESA_GIT_SHA1);
+   if (sha_len > sizeof(instance->driver_build_sha))
+      sha_len = sizeof(instance->driver_build_sha);
+   memcpy(instance->driver_build_sha, MESA_GIT_SHA1, sha_len);
+#endif
 
    *pInstance = panvk_instance_to_handle(instance);
 
