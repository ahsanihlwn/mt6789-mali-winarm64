              munmap(addr, length)
 
+#elif DETECT_OS_WINDOWS
+/* MSVC's off_t is 32-bit (long), so the AC_SYS_LARGEFILE assertion below does
+ * not describe this target and its (off_t)1 << 31 shifts are undefined.
+ * mali_drm.cpp's mmap() takes a long offset, matching off_t. */
+#  define os_mmap(addr, length, prot, flags, fd, offset) \
+             mmap(addr, length, prot, flags, fd, offset)
+
+static inline int os_munmap(void *addr, size_t length)
+{
+   return munmap(addr, length);
+}
+
