+#define PAN_INT_TO_WHANDLE(v) ((HANDLE)(intptr_t)(v))
+#else
+#define PAN_WHANDLE_TO_INT(h) (h)
+#define PAN_INT_TO_WHANDLE(v) (v)
+#endif
