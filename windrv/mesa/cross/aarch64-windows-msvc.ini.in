# ---------------------------------------------------------------------------
# Meson cross file: aarch64-windows-msvc via the LLVM toolchain (clang-cl).
#
# This is a TEMPLATE. Paths are machine-specific, so they are not committed:
# tools/setup.ps1 resolves the toolchain (windrv/kmd/tools/winsdk.ps1), fills the
# @TOKENS@ below, and writes the result to build/cross.ini (git-ignored).
#
# clang-cl (not the GNU clang driver) is used so Meson takes its MSVC-like
# path: it knows the linker is link.exe and accepts /libpath: etc. The GNU
# driver chokes on Meson's `-Wl,--version` linker probe for an MSVC target.
# The aarch64 target is requested with /clang:--target=...
#
# The *_args / *_link_args lists are built by setup.ps1 because they depend on
# the link recipe: the default one is CRT-free (see mesa/runtime/mali_cxxrt.cpp
# and mesa/README.md), because the MSVC ARM64 C/C++ runtime is not installed.
# Pass -SystemCrt to setup.ps1 to fall back to the normal default libraries.
# ---------------------------------------------------------------------------

[binaries]
c       = '@CLANGCL@'
cpp     = '@CLANGCL@'
ar      = '@LLVM_AR@'
windres = '@LLVM_RC@'

[host_machine]
system     = 'windows'
cpu_family = 'aarch64'
cpu        = 'aarch64'
endian     = 'little'

[properties]
needs_exe_wrapper = true

[built-in options]
c_args        = [@C_ARGS@]
cpp_args      = [@CPP_ARGS@]
c_link_args   = [@C_LINK_ARGS@]
cpp_link_args = [@CPP_LINK_ARGS@]
