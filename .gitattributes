# Normalize text to LF in the repository, but keep Windows-native files CRLF
# so scripts and INF files stay directly usable on a Windows checkout.
* text=auto eol=lf

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.inf  text eol=crlf

*.c    text eol=lf
*.h    text eol=lf
*.md   text eol=lf
*.py   text eol=lf

# Binary artifacts must never be line-ending converted.
*.sys  binary
*.exe  binary
*.dll  binary
*.cat  binary
*.cer  binary
*.pfx  binary
*.pdb  binary
*.obj  binary
*.lib  binary
